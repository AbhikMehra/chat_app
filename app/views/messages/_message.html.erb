<div style="margin-bottom:10px;">
  <div style="font-size:12px; color:#6b7280;">
    <%= message.user.email %>
  </div>

  <div style="
    display:inline-block;
    background:white;
    padding:8px 12px;
    border-radius:12px;
    border:1px solid #e5e7eb;
    max-width:70%;
  ">
    <%= message.content %>
  </div>
</div>

<p>
  <strong><%= message.user.email %></strong>:
  <%= message.content %>

  <% if message.file.attached? %>
    <% if message.file.image? %>
      <%= image_tag message.file, width: 200 %>
    <% else %>
      <%= link_to "Download file", message.file %>
    <% end %>
  <% end %>
</p>
